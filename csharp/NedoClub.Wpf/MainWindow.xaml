<Window x:Class="NedoClub.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NedoClub" WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" Topmost="True" Background="#0B0F1A">
  <Grid>
    <!-- Фоновый градиент для красоты -->
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B0F1A" Offset="0"/>
        <GradientStop Color="#111827" Offset="0.5"/>
        <GradientStop Color="#0B1220" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <TabControl x:Name="RootTabs" Background="#00000000" BorderThickness="0">
      <TabItem Header="Инсталлер" x:Name="TabInstaller">
        <Grid Margin="40">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0 20 0 10">
            <TextBlock Text="GTA 6 — Установщик" Foreground="#F8FAFC" FontSize="36" FontWeight="Bold"/>
            <TextBlock Text="Nedohacker Social Ultra+" Foreground="#94A3B8" FontSize="18"/>
          </StackPanel>
          <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="14">
            <ProgressBar x:Name="InstallerProgress" Height="18" Minimum="0" Maximum="100" Foreground="#22D3EE"/>
            <TextBlock x:Name="InstallerStage" Foreground="#E2E8F0" FontSize="18"/>
            <TextBlock x:Name="InstallerSub" Foreground="#94A3B8" FontSize="14"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="BtnStartInstall" Content="Установить" Padding="22 10" Background="#22D3EE" Foreground="#0B0F1A"/>
            <Button x:Name="BtnExit" Content="Выйти" Padding="22 10"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Вирус" x:Name="TabVirus">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
            <TextBlock Text="Активация NedoClub Secure-Lock" Foreground="#F8FAFC" FontSize="34" FontWeight="Bold"/>
            <TextBlock Text="Попытка закрыть окно будет проигнорирована" Foreground="#94A3B8" FontSize="16"/>
            <ProgressBar x:Name="VirusProgress" Width="640" Height="20" Minimum="0" Maximum="100" Foreground="#A78BFA"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0 24 0 24">
            <Button x:Name="BtnToBsod" Content="Перейти к BSOD" Padding="20 10" Background="#A78BFA"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="BSOD" x:Name="TabBsod">
        <Grid Background="#0A53A5">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <TextBlock Text=":(" FontSize="120" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Ваш ПК столкнулся с проблемой и нуждается в перезагрузке." Foreground="White" FontSize="22"/>
            <TextBlock Text="Мы просто собираем некоторые сведения об ошибке, затем перезагрузим." Foreground="White" FontSize="18"/>
            <TextBlock Text="КОД ОШИБКИ: I_Forget_Who_Iam_Biden" Foreground="White" FontSize="18"/>
            <ProgressBar x:Name="BsodBar" Width="680" Height="20" Minimum="0" Maximum="100"/>
            <TextBlock Text="Это шутка. Никаких изменений системы не производится." Foreground="#D1FAE5" FontSize="14"/>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Баннер аварийного выхода -->
    <Border Background="#111827" Opacity="0.9" HorizontalAlignment="Stretch" VerticalAlignment="Top">
      <TextBlock Text="Аварийный выход: Ctrl+Alt+Shift+Q — завершает и очищает псевдо-автозапуск"
                 Margin="12" Foreground="#22D3EE"/>
    </Border>

    <!-- Логин-оверлей сверху -->
    <Grid x:Name="LoginOverlay" Background="#CC0F172A">
      <Border CornerRadius="14" Padding="28" Background="#111827" BorderBrush="#22D3EE" BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Width="420" Spacing="10">
          <TextBlock Text="Nedohacker Lite — Авторизация" Foreground="#F8FAFC" FontSize="26" FontWeight="Bold"/>
          <TextBlock Text="СТРОГО ДЛЯ КАНАЛА Nedohacker lite. Я вас предупрдил!"
                     TextWrapping="Wrap" Foreground="#9CA3AF"/>
          <StackPanel Spacing="6" Margin="0 8 0 0">
            <TextBlock Text="Логин" Foreground="#CBD5E1"/>
            <TextBox x:Name="TxtUser" Text="Anubis"/>
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="Пароль" Foreground="#CBD5E1"/>
            <PasswordBox x:Name="PwdPass"/>
          </StackPanel>
          <TextBlock x:Name="LoginHint" Foreground="#FDE047" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 6 0 0">
            <Button x:Name="BtnLogin" Content="Войти" Padding="18 8" Background="#22D3EE"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>